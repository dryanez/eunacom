{
  "name": "eunacom-app-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ios": "vite --config vite.config.ios.js",
    "build": "vite build && node scripts/prerender-seo.js",
    "build:ios": "vite build --config vite.config.ios.js && mv dist-ios/index-ios.html dist-ios/index.html",
    "lint": "eslint .",
    "preview": "vite preview",
    "telegram:preview": "node ../telegram-bot/test_quiz_preview.js",
    "telegram:dry": "node ../telegram-bot/publish_daily_quiz.js --dry-run",
    "telegram:post": "node ../telegram-bot/publish_daily_quiz.js",
    "telegram:start": "node ../telegram-bot/scheduler.js",
    "marketing:preview": "node ../scripts/email_pearl_agent.js --preview",
    "marketing:dry": "node api/email-marketing-cron.js --dry-run",
    "marketing:now": "node ../scripts/marketing_scheduler.js --now",
    "marketing:start": "node ../scripts/marketing_scheduler.js",
    "seo:sync": "python3 ../scripts/gsc_seo_analyzer.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/lib-storage": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@libsql/client": "^0.14.0",
    "@supabase/supabase-js": "^2.100.1",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.7.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "pdfmake": "^0.3.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "resend": "^6.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "csv-parse": "^6.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "puppeteer": "^25.8.0",
    "vite": "^8.0.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}

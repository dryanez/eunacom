{
    "headers": [
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                },
                {
                    "key": "Pragma",
                    "value": "no-cache"
                },
                {
                    "key": "Expires",
                    "value": "0"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml; charset=utf-8"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/robots.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                }
            ]
        }
    ],
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/$1" },
        { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
        { "source": "/robots.txt", "destination": "/robots.txt" },
        { "source": "/((?!assets/|data/|img/|favicon.ico|manifest.webmanifest|sw.js|workbox-.*|sitemap\\.xml|robots\\.txt|.*\\.png|.*\\.svg|.*\\.ico|.*\\.pdf|.*\\.json).*)", "destination": "/index.html" }
    ]
}
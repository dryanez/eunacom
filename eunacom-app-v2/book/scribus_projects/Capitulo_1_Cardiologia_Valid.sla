            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style"/>
                <para PARENT="Eunacom_Title"/>
                <ITEXT CH="CAPÍTULO 1: ELECTROCARDIOGRAFÍA Y ARRITMIAS" FONT="Arial Bold" FONTSIZE="14" FCOLOR="EunacomPrimary"/>
            </StoryText>
        </PAGEOBJECT>

        <PAGEOBJECT 
            PTYPE="4" 
            XPOS="36" 
            YPOS="75" 
            WIDTH="250" 
            HEIGHT="720" 
            OwnPage="0" 
            ItemID="1002" 
            PCOLOR="None" 
            SHAPE="0" 
            COLUMNS="1" 
            COLGAP="0">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style"/>
                <para PARENT="Eunacom_H2"/>
                <ITEXT CH="1. LECTURA SISTEMÁTICA DEL ECG" FONT="Arial Bold" FONTSIZE="10" FCOLOR="EunacomPrimary"/>
                <para PARENT="Eunacom_Body"/>
                <ITEXT CH="&#10;La evaluación electrocardiográfica en el EUNACOM requiere una metodología estructurada en 5 pasos secuenciales: Ritmo, Frecuencia, Eje, Intervalos y Morfología.&#10;&#10;1. Ritmo: Identificar ondas P sinusales precediendo a cada complejo QRS con intervalo PR constante (120-200 ms).&#10;2. Frecuencia Cardíaca: 1500 / número de cuadros pequeños entre R-R, o 300 / número de cuadros grandes.&#10;3. Eje Eléctrico: Normal entre -30° y +90° (positivo en DI y aVF).&#10;4. Intervalos: PR (120-200 ms), QRS (&lt; 120 ms), QTc (&lt; 440 ms en hombres, &lt; 460 ms en mujeres).&#10;5. Alteraciones del Segmento ST y Onda T: Isquemia subendocárdica vs subepicárdica." FONT="Arial Regular" FONTSIZE="8.5" FCOLOR="DarkSlate"/>
            </StoryText>
        </PAGEOBJECT>

        <PAGEOBJECT 
            PTYPE="4" 
            XPOS="300" 
            YPOS="75" 
            WIDTH="259.275590551181" 
            HEIGHT="220" 
            OwnPage="0" 
            ItemID="1003" 
            PCOLOR="BgGray" 
            BCOLOR="BorderGray" 
            SHAPE="0" 
            COLUMNS="1" 
            COLGAP="0">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style"/>
                <para PARENT="Eunacom_H2"/>
                <ITEXT CH=" CASO CLÍNICO TIPO EUNACOM&#10;" FONT="Arial Bold" FONTSIZE="9.5" FCOLOR="EunacomAccent"/>
                <para PARENT="Eunacom_Body"/>
                <ITEXT CH="Hombre de 68 años con antecedente de HTA y diabetes mellitus que consulta por palpitaciones de inicio súbito asociadas a disnea. Al examen: PA 135/85 mmHg, FC 142 lpm irregular. ECG demuestra ausencia de ondas P, línea de base irregular (ondas f) e intervalos R-R absolutamente variables.&#10;&#10;Conducta Oficial EUNACOM: Diagnóstico de Fibrilación Auricular con RVR. El paciente se encuentra hemodinámicamente estable, por lo que la conducta inmediata es el control de frecuencia cardíaca con Betabloqueadores (Bisoprolol) o Calcioantagonistas No DHP (Diltiazem/Verapamilo) e iniciar anticoagulación según Score CHA2DS2-VASc." FONT="Arial Regular" FONTSIZE="8" FCOLOR="DarkSlate"/>
            </StoryText>
        </PAGEOBJECT>

